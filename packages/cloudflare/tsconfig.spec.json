{
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": false,
		"module": "esnext",
		"target": "esnext",
		"lib": ["esnext"],
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"types": [
			"@cloudflare/workers-types/experimental",
			"@cloudflare/vitest-plugin/types",
			"@opennextjs/aws/types/global.d.ts"
		]
	},
	"include": ["src/**/*.workerd.spec.ts"]
}
